#!/usr/bin/env bash
set -euo pipefail
# Code root: the checkout this launcher sits in (bin/ next to py/), or the
# installed tree /opt/azazel-edge when the launcher was copied elsewhere (the
# installer copies it to /usr/local/bin, whose parent holds no code). A
# symlink is not followed (BASH_SOURCE is the link's own path): a link in
# /usr/local/bin runs the installed, sync-checked tree, never whatever stale
# checkout the link may point at.
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SELF_DIR}/.." && pwd)"
if [[ ! -f "${ROOT_DIR}/py/azazel_edge/__init__.py" ]]; then
  ROOT_DIR="/opt/azazel-edge"
fi
if [[ ! -f "${ROOT_DIR}/py/azazel_edge/__init__.py" ]]; then
  echo "Azazel-Edge code not found next to ${SELF_DIR} or in ${ROOT_DIR}." >&2
  exit 1
fi
PYTHON_BIN="${AZAZEL_VENV_PYTHON:-}"
if [[ -z "${PYTHON_BIN}" ]]; then
  if [[ -x "${ROOT_DIR}/.venv/bin/python" ]]; then
    PYTHON_BIN="${ROOT_DIR}/.venv/bin/python"
  else
    PYTHON_BIN="/opt/azazel-edge/venv/bin/python"
  fi
fi
if [[ ! -x "${PYTHON_BIN}" ]]; then
  PYTHON_BIN="$(command -v python3)"
fi
export PYTHONPATH="${ROOT_DIR}:${ROOT_DIR}/py:${PYTHONPATH:-}"
exec "${PYTHON_BIN}" -m azazel_edge.dummy_eve "$@"
