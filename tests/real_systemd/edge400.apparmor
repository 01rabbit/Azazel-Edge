# Disposable Ubuntu 24.04 lab policy, never a production installer.
# No complain/unconfined fallback or attach_disconnected debugging flag.
#include <tunables/global>
profile edge400-capture /opt/edge400-runtime/bin/edge-capture {
  #include <abstractions/base>
  / r,
  /opt/ r,
  /opt/edge400-runtime/ r,
  /opt/edge400-runtime/** mr,
  /opt/edge400-runtime/bin/edge-capture ix,
  /opt/edge400-src/py/ r,
  /opt/edge400-src/py/** r,
  /usr/bin/python3.12 mr,
  /usr/local/lib/python3.12/** r,
  /etc/{passwd,group,nsswitch.conf} r,
  /sys/fs/cgroup/**/cpu.max r,
  /var/ r,
  /var/lib/ r,
  /var/lib/edge400-systemd-lab/ r,
  /var/lib/edge400-systemd-lab/bundle/ r,
  /var/lib/edge400-systemd-lab/bundle/{trust.json,origin.json,provisioned.json} r,
  /var/lib/edge400-systemd-lab/bundle/producer/ r,
  /var/lib/edge400-systemd-lab/bundle/producer/key.raw r,
  /var/lib/edge400-systemd-lab/bundle/input rwk,
  /opt/edge400-src/tests/real_systemd/role_probe.py r,
  /proc/*/attr/apparmor/current r,
  /proc/*/status r,
  /proc/*/cgroup r,
  /proc/sys/kernel/random/boot_id r,
  /sys/module/apparmor/parameters/enabled r,
  network unix,
  audit deny network inet,
  audit deny network inet6,
  signal (receive) peer=unconfined,
  audit deny signal (send) set=(exists) peer=unconfined,
  audit deny signal (send) set=(exists) peer=edge400-native,
  ptrace (readby) peer=unconfined,
}
profile edge400-witness {
  #include <abstractions/base>
  / r,
  /opt/ r,
  /opt/edge400-runtime/ r,
  /opt/edge400-runtime/** mr,
  /opt/edge400-runtime/bin/python{,3,3.12} ix,
  /usr/bin/python3.12 mrix,
  /opt/edge400-src/py/ r,
  /opt/edge400-src/py/** r,
  /opt/edge400-src/tests/real_systemd/role_probe.py r,
  /usr/local/lib/python3.12/** r,
  /etc/{passwd,group,nsswitch.conf} r,
  /sys/fs/cgroup/**/cpu.max r,
  /var/ r,
  /var/lib/ r,
  /var/lib/edge400-systemd-lab/ r,
  /var/lib/edge400-systemd-lab/bundle/ r,
  /var/lib/edge400-systemd-lab/bundle/{trust.json,origin.json,provisioned.json} r,
  /var/lib/edge400-systemd-lab/bundle/input r,
  /var/lib/edge400-systemd-lab/bundle/witness/ r,
  /var/lib/edge400-systemd-lab/bundle/witness/key.raw r,
  /var/lib/edge400-systemd-lab/bundle/witness/anchors/ r,
  /var/lib/edge400-systemd-lab/bundle/witness/anchors/** rwk,
  /var/lib/edge400-systemd-lab/bundle/observer/ r,
  /var/lib/edge400-systemd-lab/bundle/observer/observations.journal r,
  /var/lib/edge400-systemd-lab/bundle/socket/ r,
  /var/lib/edge400-systemd-lab/bundle/socket/witness.sock rw,
  /proc/*/attr/apparmor/current r,
  /proc/*/status r,
  /proc/*/cgroup r,
  /proc/sys/kernel/random/boot_id r,
  /sys/module/apparmor/parameters/enabled r,
  /run/systemd/notify w,
  capability dac_read_search,
  network unix,
  audit deny network inet,
  audit deny network inet6,
  signal (receive) peer=unconfined,
  audit deny signal (send) set=(exists) peer=unconfined,
  audit deny signal (send) set=(exists) peer=edge400-native,
  ptrace (readby) peer=unconfined,
}
profile edge400-observer /opt/edge400-runtime/bin/edge-observe {
  #include <abstractions/base>
  / r,
  /opt/ r,
  /opt/edge400-runtime/ r,
  /opt/edge400-runtime/** mr,
  /opt/edge400-runtime/bin/edge-observe ix,
  /usr/bin/python3.12 mr,
  /opt/edge400-src/py/ r,
  /opt/edge400-src/py/** r,
  /opt/edge400-src/tests/ r,
  /opt/edge400-src/tests/** r,
  /usr/local/lib/python3.12/** r,
  /etc/{passwd,group,nsswitch.conf} r,
  /sys/fs/cgroup/**/cpu.max r,
  /var/ r,
  /var/lib/ r,
  /var/lib/edge400-systemd-lab/ r,
  /var/lib/edge400-systemd-lab/bundle/ r,
  /var/lib/edge400-systemd-lab/bundle/{trust.json,origin.json,provisioned.json} r,
  /var/lib/edge400-systemd-lab/bundle/input r,
  /var/lib/edge400-systemd-lab/bundle/observer/ r,
  /var/lib/edge400-systemd-lab/bundle/observer/** rwk,
  /var/lib/edge400-systemd-lab/bundle/socket/ r,
  /var/lib/edge400-systemd-lab/bundle/socket/witness.sock rw,
  /proc/*/attr/apparmor/current r,
  /proc/*/status r,
  /proc/*/cgroup r,
  /proc/sys/kernel/random/boot_id r,
  /sys/module/apparmor/parameters/enabled r,
  network unix,
  audit deny network inet,
  audit deny network inet6,
  signal (receive) peer=unconfined,
  audit deny signal (send) set=(exists) peer=unconfined,
  audit deny signal (send) set=(exists) peer=edge400-native,
  ptrace (readby) peer=unconfined,
}

# Entered by sealed Rust bootstrap before configuration/threads/native start.
# No exec, profile change, policy management or role-key/evidence permissions.
profile edge400-native {
  #include <abstractions/base>
  / r,
  /var/ r,
  /var/lib/ r,
  /var/lib/edge400-systemd-lab/ r,
  /var/lib/edge400-systemd-lab/eve.json r,
  /var/lib/edge400-systemd-lab/native/ r,
  /var/lib/edge400-systemd-lab/native/** rwk,
  /proc/*/attr/apparmor/current r,
  /proc/*/status r,
  /proc/*/stat r,
  /proc/sys/kernel/random/boot_id r,
  /dev/fd/* rwk,
  network unix,
  audit deny network inet,
  audit deny network inet6,
  signal (receive) peer=unconfined,
  ptrace (readby) peer=unconfined,
}
