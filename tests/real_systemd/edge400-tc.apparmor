# Explicit legacy TBF recovery lab only; never a production installer.
#include <tunables/global>
profile edge400-tc {
  #include <abstractions/base>
  / r,
  /var/ r,
  /var/lib/ r,
  /var/lib/edge400-systemd-lab/ r,
  /var/lib/edge400-systemd-lab/eve.json r,
  /var/lib/edge400-systemd-lab/native/ r,
  /var/lib/edge400-systemd-lab/native/** rwk,
  /proc/*/attr/apparmor/current r,
  /proc/*/status r,
  /proc/*/stat r,
  /proc/*/net/psched r,
  /proc/sys/kernel/random/boot_id r,
  /dev/fd/* rwk,
  /usr/ r,
  /usr/sbin/ r,
  /usr/sbin/tc mrix,
  /usr/lib/tc/** mr,
  capability net_admin,
  network netlink raw,
  network netlink dgram,
  network unix,
  audit deny network inet,
  audit deny network inet6,
  signal (receive) peer=unconfined,
  ptrace (readby) peer=unconfined,
}
