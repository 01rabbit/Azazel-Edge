[Unit]
Description=Azazel-Edge AI Advisory Agent (Unix socket consumer)
After=network.target

[Service]
Type=simple
# Edge#471 stage 2: the agent runs as its own non-root account. It writes
# only in its own directories:
#   /run/azazel-edge-ai           ai-bridge.sock (0700, RuntimeDirectory=)
#   /run/azazel-edge-agent        advisory, metrics, policy, its snapshot
#                                 fields (2750 azazel-agent:azazel-web)
#   /run/azazel-edge-agent-query  the Web UI's manual_query socket
#                                 (2750 azazel-agent:azazel-web)
#   /var/log/azazel-edge/ai       AI logs, the core-decision audit chain and
#                                 the P0 queue (2750 azazel-agent:azazel-web)
#   /var/lib/azazel-edge-agent    the decision log (StateDirectory=)
# The group-shared ones are created by tmpfiles.d (azazel-edge-agent.conf);
# ExecStartPre re-applies it as root so they exist after /run is cleared.
# The core (root) still connects to ai-bridge.sock.
User=azazel-agent
Group=azazel-agent
RuntimeDirectory=azazel-edge-ai
RuntimeDirectoryMode=0700
StateDirectory=azazel-edge-agent
StateDirectoryMode=0750
UMask=0027
ExecStartPre=+/usr/bin/systemd-tmpfiles --create /etc/tmpfiles.d/azazel-edge-agent.conf
ReadWritePaths=/run/azazel-edge-agent /run/azazel-edge-agent-query /var/log/azazel-edge/ai
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# AF_INET/AF_INET6: Ollama on loopback. AF_NETLINK: `ip -4 route show default`.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
EnvironmentFile=-/etc/default/azazel-edge-security
Environment="AZAZEL_LLM_MODEL_PRIMARY=qwen3.5:2b"
Environment="AZAZEL_LLM_MODEL_DEGRADED=qwen3.5:0.8b"
Environment="AZAZEL_OPS_MODEL=qwen3.5:2b"
Environment="AZAZEL_OPS_ENABLED=1"
Environment="AZAZEL_OPS_MODEL_CHAIN=qwen3.5:2b,qwen3.5:0.8b"
Environment="AZAZEL_OPS_KEEP_ALIVE=0s"
Environment="AZAZEL_OPS_NUM_PREDICT=80"
Environment="AZAZEL_OPS_MIN_MEM_AVAILABLE_MB=1400"
Environment="AZAZEL_OPS_MAX_SWAP_USED_MB=512"
Environment="AZAZEL_OPS_ESCALATE_MIN_RISK=70"
Environment="AZAZEL_OPS_ESCALATE_LOW_CONF=0.60"
Environment="AZAZEL_OPS_ESCALATE_COOLDOWN_SEC=180"
Environment="AZAZEL_LLM_TIMEOUT_SEC=45"
Environment="AZAZEL_LLM_RETRY_MAX=0"
Environment="AZAZEL_LLM_RETRY_BACKOFF_SEC=0.5"
Environment="AZAZEL_LLM_QUEUE_MAX=8"
Environment="AZAZEL_LLM_AMBIG_MIN=60"
Environment="AZAZEL_LLM_AMBIG_MAX=79"
Environment="AZAZEL_LLM_AMBIG_MIN_DEGRADED=70"
Environment="AZAZEL_LLM_NUM_CTX=256"
Environment="AZAZEL_LLM_NUM_PREDICT=120"
Environment="AZAZEL_LLM_NUM_THREAD=2"
Environment="AZAZEL_LLM_KEEP_ALIVE=5m"
Environment="AZAZEL_LLM_THINK=0"
Environment="AZAZEL_CORR_ENABLED=1"
Environment="AZAZEL_CORR_WINDOW_SEC=300"
Environment="AZAZEL_CORR_REPEAT_THRESHOLD=4"
Environment="AZAZEL_CORR_SID_DIVERSITY_THRESHOLD=3"
Environment="AZAZEL_CORR_MIN_RISK_SCORE=20"
Environment="AZAZEL_CORR_MAX_HISTORY_PER_SRC=32"
ExecStart=/opt/azazel-edge/venv/bin/python /opt/azazel-edge/py/azazel_edge_ai/agent.py
Restart=always
RestartSec=2
# 78 (EX_CONFIG): the SOC policy or ATT&CK mapping under
# /opt/azazel-edge/config is invalid; restarting cannot fix that.
RestartPreventExitStatus=78

[Install]
WantedBy=multi-user.target
