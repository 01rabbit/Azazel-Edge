[Unit]
Description=Azazel-Edge SNMP Poller - network device monitoring bridge
Documentation=https://github.com/01rabbit/Azazel-Edge
After=network.target azazel-edge-control-daemon.service
Wants=azazel-edge-control-daemon.service
DefaultDependencies=no

[Service]
Type=simple
# systemd does not expand ${VAR:-default} (only $VAR and ${VAR}), so the
# defaults are set here and /etc/default/azazel-edge-sensors (read below,
# which overrides Environment=) changes them. PYTHONPATH: `-m` needs the
# installed tree; the venv does not hold the azazel_edge package.
Environment="SNMP_TARGETS=[]"
Environment="SNMP_POLL_INTERVAL_SEC=60"
Environment="PYTHONPATH=/opt/azazel-edge/py"
EnvironmentFile=-/etc/default/azazel-edge-sensors
ExecStart=/opt/azazel-edge/venv/bin/python3 -m azazel_edge.sensors.snmp_poller --targets "${SNMP_TARGETS}" --interval "${SNMP_POLL_INTERVAL_SEC}"
Restart=on-failure
RestartSec=30s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=azazel-snmp
MemoryMax=32M
CPUQuota=5%
# Dedicated system account (Edge#477), created by setup_sensor_account.sh;
# not the device's login account azazel.
User=azazel-sensor
Group=azazel-sensor

[Install]
WantedBy=multi-user.target

