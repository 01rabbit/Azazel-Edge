[Unit]
Description=Azazel-Edge Control Daemon (mode state, display and Wi-Fi uplink over a Unix socket)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/default/azazel-edge-security
# The installed tree and its venv, named directly (not the /usr/local/bin
# launcher), so the unit does not depend on where a launcher looks for code.
Environment="PYTHONPATH=/opt/azazel-edge:/opt/azazel-edge/py"
ExecStart=/opt/azazel-edge/venv/bin/python /opt/azazel-edge/py/azazel_edge_control/daemon.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
