# Azazel-Edge host firewall (Edge#477). Installed as
# /etc/azazel-edge/host-firewall/azazel-host.nft and loaded only by
# /usr/local/sbin/azazel-host-firewall, which puts
# "table inet azazel_host; delete table inet azazel_host" in front of it so
# one `nft -f` replaces the table atomically. It is kept out of
# /etc/nftables.d on purpose: an nftables.conf that includes that directory
# would load it at boot even while the host firewall is off or unconfirmed.
#
# Its own table: the Rust core's enforcement uses `table inet azazel_edge`
# and the internal NAT `table ip azazel_internal`; replacing this table never
# touches theirs. A drop in any table is final, so the accepts here only end
# this table's evaluation; they open nothing another table drops.
#
# The internal LAN is br0. Every other interface (the uplink, a VPN, ...) is
# treated as WAN.
table inet azazel_host {
  # Filled from remote-access.nft (WAN SSH and mDNS) when ALLOW_EXTERNAL_SSH=true
  # or set_dev_remote_access.sh MODE=open turned remote access on.
  chain wan_allow {
  }

  chain input {
    type filter hook input priority filter; policy drop;
    iif "lo" accept
    ct state invalid drop
    ct state { established, related } accept
    iifname "br0" accept
    # WAN: ICMP for path MTU and diagnostics, rate-limited echo.
    meta l4proto icmp icmp type { destination-unreachable, time-exceeded, parameter-problem } accept
    meta l4proto icmp icmp type echo-request limit rate 10/second accept
    # WAN IPv6: neighbour discovery, router advertisements, MLD queries and
    # packet-too-big; without them IPv6 on the uplink stops working.
    meta l4proto ipv6-icmp icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept
    ip6 saddr fe80::/10 meta l4proto ipv6-icmp icmpv6 type mld-listener-query accept
    meta l4proto ipv6-icmp icmpv6 type echo-request limit rate 10/second accept
    # WAN DHCP client: server replies are not always tracked as replies
    # (the request was a broadcast), so they are allowed by port.
    udp sport 67 udp dport 68 accept
    ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept
    jump wan_allow
    counter comment "azazel-host: wan default deny"
  }

  chain forward {
    type filter hook forward priority filter; policy accept;
    ct state { established, related } accept
    # LAN -> anywhere, and the containers' own bridges (docker0, br-*):
    # unchanged.
    iifname { "br0", "docker0" } accept
    iifname "br-*" accept
    # No new connection from the WAN into the LAN.
    oifname "br0" ct state new counter drop comment "azazel-host: wan to lan new"
    # No new WAN connection to a published container port: Docker DNATs it in
    # prerouting and it arrives here (not in input) towards docker0/br-*.
    # A drop here is final whatever Docker's own FORWARD/DOCKER-USER chains
    # (iptables-nft, table ip filter) accept.
    ct status dnat ct state new counter drop comment "azazel-host: wan dnat new"
  }
}
